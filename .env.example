# Find_comm_papers configuration. Copy to .env beside launch.py.
# Keep credentials and runtime data outside the repository.
# Existing process environment variables take precedence.

# CNKI: bfsu_webvpn for BFSU off-campus access; direct for direct access.
COMM_CNKI_ACCESS_MODE=bfsu_webvpn
# Required: existing compatible CloakBrowser / Chromium executable.
COMM_CNKI_BROWSER_PATH='D:\Browsers\CloakBrowser\chrome.exe'
# Private data: browser sessions, PDFs, manifests, receipts and encrypted grants.
COMM_MCP_DATA_DIR='D:\Research\FindPapersData'
# Optional upstream tools; the bilingual main workflow stays CNKI + WoS.
COMM_ENABLE_LEGACY_TOOLS=0

# Optional custom ranking profile.
# COMM_MCP_PROFILE='D:\Research\ranking-profile.json'
# Optional API settings used only by relevant compatibility tools.
# PAPER_SEARCH_MCP_OPENALEX_API_KEY=
# PAPER_SEARCH_MCP_OPENALEX_EMAIL=
# PAPER_SEARCH_MCP_SEMANTIC_SCHOLAR_API_KEY=
# PAPER_SEARCH_MCP_UNPAYWALL_EMAIL=
